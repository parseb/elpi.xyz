# ==============================================================================
# OptionCore (elpi.xyz) Environment Configuration — Base Mainnet & Devnet
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NETWORK & CHAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Target chain identifier: "base" for Base Mainnet, "basesepolia" for Sepolia, "anvil" for devnet
NEXT_PUBLIC_TARGET_CHAIN=base
NEXT_PUBLIC_CHAIN_ID=8453
CHAIN_ID=8453

# Base Mainnet RPC endpoints (Alchemy, Infura, QuickNode, or public Base RPC)
MAINNET_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# ------------------------------------------------------------------------------
# 2. CANONICAL BASE MAINNET ASSETS & ORACLES
# ------------------------------------------------------------------------------
# Standard verified ERC-20 token addresses on Base Mainnet
NEXT_PUBLIC_BASE_WETH=0x4200000000000000000000000000000000000006
NEXT_PUBLIC_BASE_USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
NEXT_PUBLIC_BASE_WBTC=0x0555E30da8f98308EdB960aa94C0Db47230d2B9c

# Chainlink Price Feeds on Base Mainnet
NEXT_PUBLIC_BASE_CHAINLINK_ETH_USD=0x71041dddad3595F9CEd3DcCFBe3D1F4b0a16Bb70
NEXT_PUBLIC_BASE_WBTC_ORACLE=0xcCa4841320c37E68674D3204ef36234Fd660608C

# Canonical ERC-6551 Registry on Base
NEXT_PUBLIC_BASE_ERC6551_REGISTRY=0x000000006551c19487814612e58FE06813775758

# ------------------------------------------------------------------------------
# 3. UNISWAP V4 INFRASTRUCTURE (BASE MAINNET DEPLOYMENTS)
# ------------------------------------------------------------------------------
# Canonical Uniswap v4 PoolManager on Base
NEXT_PUBLIC_BASE_POOL_MANAGER=0x_BASE_V4_POOL_MANAGER_ADDRESS

# UniswapV4VenueAdapter contract address
NEXT_PUBLIC_BASE_VENUE_ADAPTER=0x_BASE_VENUE_ADAPTER_ADDRESS

# OptionSettlementHook mined with flags 0xC8 (BEFORE_SWAP, AFTER_SWAP, BEFORE_SWAP_RETURNS_DELTA)
NEXT_PUBLIC_BASE_OPTION_HOOK=0x_BASE_OPTION_HOOK_ADDRESS

# V4LiquidityVault (Stages idle LP collateral in v4)
NEXT_PUBLIC_BASE_VAULT=0x_BASE_VAULT_ADDRESS

# Route ID for canonical pool: keccak256(abi.encode(PoolKey))
NEXT_PUBLIC_BASE_ROUTE_ID=0x_BASE_ROUTE_ID_HEX

# ------------------------------------------------------------------------------
# 4. PROTOCOL CORE & CONDITIONS (BASE MAINNET)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BASE_POSITION_MANAGER=0x_BASE_POSITION_MANAGER_ADDRESS
NEXT_PUBLIC_BASE_LP_ROUTER=0x_BASE_LP_ROUTER_ADDRESS
NEXT_PUBLIC_BASE_AUTHZ_MODULE=0x_BASE_AUTHZ_MODULE_ADDRESS
NEXT_PUBLIC_BASE_CONDITION_ARBITER=0x_BASE_CONDITION_ARBITER_ADDRESS
NEXT_PUBLIC_BASE_POSITION_ACCOUNT_IMPL=0x_BASE_POSITION_ACCOUNT_IMPL_ADDRESS
NEXT_PUBLIC_BASE_EXPIRY_CONDITION=0x_BASE_EXPIRY_CONDITION_ADDRESS
NEXT_PUBLIC_BASE_TAKER_PROFIT_CONDITION=0x_BASE_TAKER_PROFIT_CONDITION_ADDRESS

# ------------------------------------------------------------------------------
# 5. SERVER RUNTIME & PERSISTENT ORDER BOOK
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Persistent storage file path on attached Railway Volume (/app/data mount)
DATABASE_PATH=/app/data/profiles-store.json
